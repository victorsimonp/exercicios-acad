{
  "name": "@ht/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx src/check-db.ts"
  },
  "dependencies": {
    "@ht/shared": "workspace:*",
    "fastify": "^5.0.0",
    "@fastify/cors": "^11.0.0",
    "zod": "^4.0.0",
    "dotenv": "^17.0.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0"
  }
}
